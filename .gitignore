# Terraform state, caches and saved plans can contain sensitive data.
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
*.tfvars.json
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Local credentials and editor/OS files.
.env
.env.*
!.env.example
.databrickscfg
**/.databricks/
.DS_Store

# Commit .terraform.lock.hcl: it records exact provider selections.

# environment file
.env

# Python bytecode.
__pycache__/
*.py[cod]

# Keep the lab journal local; publish only the reviewed CI design and plan.
docs/*
!docs/superpowers/
docs/superpowers/*
!docs/superpowers/specs/
!docs/superpowers/plans/
docs/superpowers/specs/*
docs/superpowers/plans/*
!docs/superpowers/specs/2026-10-05-ci-foundation-design.md
!docs/superpowers/plans/2026-10-09-ci-foundation.md
